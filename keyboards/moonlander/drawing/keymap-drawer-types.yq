.layers[] |= map(
  (select(tag == "!!str") | {"t": .}) // . |
  with(select(has("h")); .h |= (sub("^MOD_[LR]GUI$"; "⌘") | sub("^MOD_[LR]ALT$"; "⌥") | sub("^MOD_[LR]CTL$"; "⌃") | sub("^MOD_[LR]SFT$"; "⇧"))) |
  (.t // "") as $t |
  (.h // "") as $h |
  (
    (select($t == "" or $t == "▽") | .) //
    (select($t == "fn" or $t == "⌘" or $t == "⌥" or $t == "⌃" or $t == "⇧" or $h == "⌘" or $h == "⌥" or $h == "⌃") | .type = "mod") //
    (select($t == "Base" or $t == "Symbols" or $t == "Media" or $t == "Windows" or $h == "Base" or $h == "Symbols" or $h == "Media" or $h == "Windows") | .type = "layer") //
    (select($t == "⌫" or $t == "⌦" or $t == "⏎" or $t == "⇥" or $t == "␣" or $t == "Esc" or $t == "⇪" or $t == "Menu") | .type = "edit") //
    (select($t | test("^[0-9]$")) | .type = "num") //
    (select($t | test("^F[0-9]+$")) | .type = "fn") //
    (select($t == "↑" or $t == "↓" or $t == "←" or $t == "→" or $t == "PgUp" or $t == "PgDn" or ($t | test("^MS "))) | .type = "nav") //
    (select($t | test("^(RGB|HSV|TOGGLE|LEDs)")) | .type = "light") //
    (select($t == "⏯" or $t == "⏮" or $t == "⏭") | .type = "play") //
    (select($t == "🎧") | .type = "headphones") //
    (select($t == "Vol+" or $t == "Vol−") | .type = "volume") //
    (select($t == "Mute") | .type = "mute") //
    (select($t == "Sound on/off" or $t == "Music mode" or $t == "Music scale") | .type = "sound") //
    (select($t == "Boot") | .type = "boot") //
    (select(($t | test("^WS ([1-9]|1[0-3]|2[1-3])$")) or $t == "Left" or $t == "Main" or $t == "Laptop") | .type = "window" | .s = "⇧ move") //
    (select(($t | test("^(WS [0-9]+|Focus .)$")) or $t == "Launcher") | .type = "window") //
    .
  )
) |
# Base keys show their shifted character as a top legend, like printed keycaps.
{"`": "~", "1": "!", "2": "@", "3": "#", "4": "$", "5": "%", "6": "^", "7": "&", "8": "*", "9": "(", "0": ")",
 "-": "_", "=": "+", "[": "{", "]": "}", "\\": "|", ";": ":", "'": "\"", ",": "<", ".": ">", "/": "?"} as $shifted |
.layers.Base |= map(with(select($shifted[.t]); .s = $shifted[.t]))
|
[0, 1, 2, 3, 4, 5, 6, 14, 15, 16, 17, 18, 19, 20, 28, 29, 30, 31, 32, 33, 34, 42, 43, 44, 45, 46, 47, 54, 55, 56, 57, 58, 59, 66, 67, 68] as $left |
.layers.Symbols |= (to_entries | map(.key as $k | .value | with(select(.type == null and (.t // "") != "" and ($left | any_c(. == $k))); .type = "sym")))
