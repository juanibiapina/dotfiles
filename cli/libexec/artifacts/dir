#!/usr/bin/env bash
#
# Summary: Print the pi artifact directory for a project
#
# Usage: {cmd} [path]
#
# Arguments:
#   path: Directory inside the project. Defaults to the current directory.
#
# The directory is the sha256 of the project root (git top-level, falling back
# to the path itself), truncated to 16 hex characters, under
# $XDG_STATE_HOME/pi-artifacts (default ~/.local/state/pi-artifacts). Prints the
# path whether or not it exists yet.
#
# This is the only definition of the location: the pi artifacts extension asks
# this command rather than deriving it, so no process can disagree about where a
# project's artifacts live.

set -e

declare -A args="($_DEV_ARGS)"

path="${args[path]:-$PWD}"

if ! root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)"; then
  root=""
fi

if [ -z "$root" ]; then
  root="$(cd "$path" && pwd -P)"
fi

base="${XDG_STATE_HOME:-$HOME/.local/state}"
base="${base%/}"

hash="$(printf '%s' "$root" | shasum -a 256 | cut -c1-16)"

printf '%s\n' "$base/pi-artifacts/$hash"
