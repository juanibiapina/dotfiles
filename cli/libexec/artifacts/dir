#!/usr/bin/env bash
#
# Summary: Print the pi artifact directory for a project
#
# Usage: {cmd} [path]
#
# Arguments:
#   path: Directory inside the project. Defaults to the current directory.
#
# Reproduces the location the pi artifacts extension derives: the sha256 of the
# project root (git top-level, falling back to the path itself), truncated to 16
# hex characters, under <tmpdir>/pi-artifacts. Prints the path whether or not it
# exists yet.

set -e

declare -A args="($_DEV_ARGS)"

path="${args[path]:-$PWD}"

if ! root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)"; then
  root=""
fi

if [ -z "$root" ]; then
  root="$(cd "$path" && pwd -P)"
fi

# Node's os.tmpdir() strips the trailing slash macOS puts on TMPDIR.
tmp="${TMPDIR:-/tmp}"
tmp="${tmp%/}"

hash="$(printf '%s' "$root" | shasum -a 256 | cut -c1-16)"

printf '%s\n' "$tmp/pi-artifacts/$hash"
