#!/usr/bin/env bash
#
# Summary: Delete a pi artifact
#
# Usage: {cmd} <name> [path]
#
# Arguments:
#   name: Artifact name to slugify.
#   path: Directory inside the project. Defaults to the current directory.

set -e

source "$(dirname "${BASH_SOURCE[0]}")/common"
declare -A args="($_DEV_ARGS)"

path="${args[path]:-$PWD}"
dir="$(artifact_dir "$path")"
target="$(artifact_path "$dir" "${args[name]}")"
file="$(basename "$target")"

[ -f "$target" ] || { printf 'No artifact named "%s" to delete.\n' "$file" >&2; exit 1; }
rm "$target"

remove_sidecar_entry() {
  local sidecar="$dir/.index.json" temp
  [ -f "$sidecar" ] || return 0
  prepare_sidecar "$sidecar"
  temp="$(mktemp "$dir/.index.json.XXXXXX")"
  jq --arg name "$file" 'del(.[$name])' "$sidecar" > "$temp"
  mv "$temp" "$sidecar"
}

with_index_lock "$dir" remove_sidecar_entry
printf '%s\n' "$target"
