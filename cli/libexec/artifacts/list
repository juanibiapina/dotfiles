#!/usr/bin/env bash
#
# Summary: List the pi artifacts of a project
#
# Usage: {cmd} [--format=FORMAT] [path]
#
# Arguments:
#   path: Directory inside the project. Defaults to the current directory.
#
# Options:
#   --format=FORMAT: Output format: tsv (default) or json.

set -e

source "$(dirname "${BASH_SOURCE[0]}")/common"
declare -A args="($_DEV_ARGS)"

path="${args[path]:-$PWD}"
format="${args[format]:-tsv}"
[ "$format" = tsv ] || [ "$format" = json ] || { printf 'Unknown artifact list format: %s\n' "$format" >&2; exit 1; }
dir="$(artifact_dir "$path")"
[ -d "$dir" ] || { [ "$format" = json ] && printf '[]\n'; exit 0; }

sidecar="$dir/.index.json"
if [ -f "$sidecar" ]; then
  jq -e 'type == "object"' "$sidecar" >/dev/null
else
  sidecar=/dev/null
fi

mtime() {
  local value
  value="$(stat -f %m "$1" 2>/dev/null || true)"
  [[ "$value" =~ ^[0-9]+$ ]] && { printf '%s\n' "$value"; return; }
  stat -c %Y "$1"
}

age() {
  local secs=$1 mins hours days
  [ "$secs" -lt 0 ] && secs=0
  if [ "$secs" -lt 60 ]; then echo "just now"; return; fi
  mins=$((secs / 60))
  if [ "$mins" -lt 60 ]; then echo "${mins}m ago"; return; fi
  hours=$((mins / 60))
  if [ "$hours" -lt 24 ]; then echo "${hours}h ago"; return; fi
  days=$((hours / 24))
  echo "${days}d ago"
}

now="$(date +%s)"
records=()
shopt -s nullglob
for file in "$dir"/*; do
  [ -f "$file" ] || continue
  seconds="$(mtime "$file")"
  name="$(basename "$file")"
  records+=("$seconds"$'\t'"$name"$'\t'"$file")
done

if [ "$format" = json ]; then
  for record in "${records[@]}"; do
    IFS=$'\t' read -r seconds name file <<< "$record"
    jq -n --arg name "$name" --arg path "$file" --arg age "$(age $((now - seconds)))" --argjson mtimeMs "$((seconds * 1000))" \
      --slurpfile metadata "$sidecar" \
      '{name: $name, path: $path, mtimeMs: $mtimeMs, title: ($metadata[0][$name].title // null), type: ($metadata[0][$name].type // null), age: $age}'
  done | jq -s 'sort_by(.mtimeMs) | reverse'
else
  declare -A types=() titles=()
  if [ "$sidecar" != /dev/null ]; then
    while IFS=$'\t' read -r name type title; do
      [ -n "$name" ] || continue
      types["$name"]="$type"
      titles["$name"]="$title"
    done < <(jq -r 'to_entries[] | [.key, (.value.type // ""), (.value.title // "")] | @tsv' "$sidecar")
  fi
  for record in "${records[@]}"; do
    IFS=$'\t' read -r seconds name file <<< "$record"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$seconds" "$name" "${types[$name]-}" "${titles[$name]-}" "$(age $((now - seconds)))" "$file"
  done | sort -rn | cut -f2-
fi
