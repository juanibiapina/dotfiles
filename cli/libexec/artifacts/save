#!/usr/bin/env bash
#
# Summary: Save a pi artifact
#
# Usage: {cmd} [--content-file=FILE] [--title=TITLE] [--type=TYPE] <name> [path]
#
# Options:
#   name (script): Artifact name to slugify.
#   path: Directory inside the project. Defaults to the current directory.
#   content-file: File containing the artifact content. Reads stdin when omitted.
#   title: Human-readable title to record.
#   type: Short category to record.

set -e

source "$(dirname "${BASH_SOURCE[0]}")/common"

if [[ "$_DEV_COMPLETE" == "true" ]]; then
  [[ "$_DEV_COMPLETE_ARG" == "name" ]] && artifact_complete_names
  exit 0
fi

declare -A args="($_DEV_ARGS)"

path="${args[path]:-$PWD}"
dir="$(artifact_dir "$path")"
target="$(artifact_path "$dir" "${args[name]}")"
file="$(basename "$target")"

umask 077
mkdir -p -m 700 "$dir"
if [[ -v 'args[content-file]' ]]; then
  cat "${args[content-file]}" > "$target"
else
  content_file="$(mktemp "$dir/.content.XXXXXX")"
  trap 'rm -f "$content_file"' EXIT
  cat > "$content_file"
  [ -s "$content_file" ] || { printf 'Artifact content is empty\n' >&2; exit 1; }
  mv "$content_file" "$target"
  trap - EXIT
fi

update_sidecar() {
  local sidecar="$dir/.index.json" temp source
  prepare_sidecar "$sidecar"
  temp="$(mktemp "$dir/.index.json.XXXXXX")"
  if [ -f "$sidecar" ]; then source="$sidecar"; else source=/dev/stdin; fi
  jq --arg name "$file" --arg title "${args[title]-}" --argjson has_title "$( [[ -v 'args[title]' ]] && echo true || echo false )" \
     --arg type "${args[type]-}" --argjson has_type "$( [[ -v 'args[type]' ]] && echo true || echo false )" \
     '.[$name] = ((.[$name] // {}) | (if $has_title then .title = $title else . end) | (if $has_type then .type = $type else . end))' \
     "$source" > "$temp" < <(printf '{}\n')
  mv "$temp" "$sidecar"
}

if [[ -v 'args[title]' || -v 'args[type]' ]]; then
  with_index_lock "$dir" update_sidecar
fi

printf '%s\n' "$target"
