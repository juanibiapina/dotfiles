#!/usr/bin/env bash
#
# Summary: Push and open a pull request for current branch
#
# Usage: {cmd} [--draft] [base]
#
# If `base` is not passed, it'll be detected automatically in this order of
# priority: main -> master

set -e

declare -A args="($_DEV_ARGS)"

base="${args[base]}"
draft="${args[draft]}"

if [ -z "$base" ]; then
  if git rev-parse --verify "origin/main" &>/dev/null; then
    base="main"
  else
    base="master"
  fi
fi

git push -u origin HEAD

if [ "$draft" = "true" ]; then
  gh pr create --draft --fill --base "$base"
  gh pr view --web
else
  gh pr create --web --base "$base"
fi
