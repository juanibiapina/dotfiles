#!/usr/bin/env bash
#
# Summary: Benchmark interactive zsh startup (warm, cold, zprof)
#
# Usage: {cmd}
#
# Runs three measurements:
#   - warm:  repeated `zsh -ic exit` with hyperfine (caches hot)
#   - cold:  same, deleting ~/.zcompdump* before each run
#   - zprof: function/hook profile via ZSH_PROFILE=zprof
#
# Subprocess `eval "$(...)"` costs are invisible to zprof; use
# `dev zsh-profile analyze` on an xtrace log for those.

set -e

echo "== warm =="
hyperfine --warmup 5 --runs 30 'zsh -ic exit'

echo
echo "== cold (fresh compdump each run) =="
hyperfine --warmup 1 --runs 10 --prepare 'rm -f ~/.zcompdump*' 'zsh -ic exit'

echo
echo "== zprof (function/hook profile) =="
ZSH_PROFILE=zprof zsh -ic exit 2>&1 | sed -n '1,25p'
