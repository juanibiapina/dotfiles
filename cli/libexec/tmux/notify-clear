#!/usr/bin/env bash
#
# Summary: Clear notifications for the current tmux pane
#
# Usage: {cmd}
#
# Removes the current pane ID from @pi_notifications. It also removes the
# current session name so entries written before the pane-ID migration clear.

set -e

raw="$(tmux show-option -gqv @pi_notifications)"
[ -z "$raw" ] && exit 0

current_pane="$(tmux display-message -p '#{pane_id}')"
current_session="$(tmux display-message -p '#{session_name}')"

IFS=',' read -ra entries <<< "$raw"
result=()
for entry in "${entries[@]}"; do
  if [ "$entry" != "$current_pane" ] && [ "$entry" != "$current_session" ]; then
    result+=("$entry")
  fi
done

if [ ${#result[@]} -eq 0 ]; then
  tmux set-option -gu @pi_notifications
else
  IFS=','
  tmux set-option -g @pi_notifications "${result[*]}"
fi
