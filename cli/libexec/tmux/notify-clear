#!/usr/bin/env bash
#
# Summary: Clear pending pi notifications on a tmux window
#
# Usage: {cmd} [window-id]
#
# Unsets @pi_state=notify (and @pi_notify_at) on every pane of the target window
# (default: the current window), then recomputes the window rollup @pi_win_state
# (working > notify > unset) that the tab marker reads. Called by the navigation
# hooks so a pending-notification marker clears when its window is viewed, and by
# notify-switch after it jumps to a window.

set -e

win="${1:-$(tmux display-message -p '#{window_id}')}"
[ -n "$win" ] || exit 0

# Clear notify markers on this window's panes; leave working panes untouched.
while IFS=$'\t' read -r pane state; do
  if [ "$state" = "notify" ]; then
    tmux set -pu -t "$pane" @pi_state 2>/dev/null || true
    tmux set -pu -t "$pane" @pi_notify_at 2>/dev/null || true
  fi
done < <(tmux list-panes -t "$win" -F "#{pane_id}"$'\t'"#{@pi_state}" 2>/dev/null)

# Recompute the rollup: working beats notify beats nothing.
worst=""
while IFS= read -r s; do
  case "$s" in
    working) worst=working; break ;;
    notify) [ -z "$worst" ] && worst=notify ;;
  esac
done < <(tmux list-panes -t "$win" -F "#{@pi_state}" 2>/dev/null)

if [ -z "$worst" ]; then
  tmux set -wu -t "$win" @pi_win_state 2>/dev/null || true
else
  tmux set -w -t "$win" @pi_win_state "$worst" 2>/dev/null || true
fi
