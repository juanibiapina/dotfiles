#!/usr/bin/env bash
#
# Summary: Open a link captured from a mouse click in tmux
#
# Usage: {cmd} <candidate> [pane_id] [tmux_socket]
#
# Opens local files in the clicked session's Neovim and URLs in the browser.
# The tmux mouse binding supplies the pane and server; callers without them
# use the current tmux session for local files.
#
# tmux word selection splits on whitespace only, once `word-separators` is
# narrowed for the binding. A URL at the end of a sentence therefore arrives as
# "https://x/a." and one in brackets as "(https://x/b)", both of which break the
# browser. Wrapping punctuation is trimmed here.
#
# Closing brackets are only trimmed when unbalanced, so
# https://en.wikipedia.org/wiki/Foo_(bar) survives intact.

set -e

declare -A args="($_DEV_ARGS)"

candidate="${args[candidate]}"
pane_id="${args[pane_id]:-}"
tmux_socket="${args[tmux_socket]:-}"

[ -z "$candidate" ] && exit 0

count_char() {
  local s="$1" c="$2" stripped
  stripped="${s//[!$c]/}"
  printf '%s' "${#stripped}"
}

# Trim opening punctuation.
while :; do
  case "$candidate" in
    [\(\[\{\<\"\']*) candidate="${candidate#?}" ;;
    *) break ;;
  esac
done

# Trim closing punctuation, keeping balanced brackets.
while :; do
  case "$candidate" in
    *[.,\;:!?\"\']) candidate="${candidate%?}" ;;
    *\))
      if [ "$(count_char "$candidate" ')')" -gt "$(count_char "$candidate" '(')" ]; then
        candidate="${candidate%?}"
      else
        break
      fi ;;
    *\])
      if [ "$(count_char "$candidate" ']')" -gt "$(count_char "$candidate" '[')" ]; then
        candidate="${candidate%?}"
      else
        break
      fi ;;
    *) break ;;
  esac
done

case "$candidate" in
  file://*)
    filename="$(node -e 'const { fileURLToPath } = require("node:url"); try { console.log(fileURLToPath(process.argv[1])); } catch { process.exit(1); }' "$candidate")" || exit 1
    ;;
  /*) filename="$candidate" ;;
  [a-zA-Z]*://*) filename="" ;;
  *) exit 0 ;;
esac

if [ -n "$filename" ]; then
  line=""
  if [ ! -f "$filename" ] && [[ "$filename" =~ ^(.+):([1-9][0-9]*)$ ]]; then
    if [ -f "${BASH_REMATCH[1]}" ]; then
      line="${BASH_REMATCH[2]}"
      filename="${BASH_REMATCH[1]}"
    fi
  fi
  [ -f "$filename" ] || exit 1
  dev tmux edit "$filename" "$pane_id" "$tmux_socket" "$line"
  exit
fi

if command -v open >/dev/null 2>&1; then
  open -- "$candidate"
elif command -v xdg-open >/dev/null 2>&1; then
  nohup xdg-open "$candidate" >/dev/null 2>&1
elif [ -n "$BROWSER" ]; then
  "$BROWSER" "$candidate"
fi
