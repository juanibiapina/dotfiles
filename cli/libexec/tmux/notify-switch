#!/usr/bin/env bash
#
# Summary: Switch to the oldest pane with a pending Pi notification
#
# Usage: {cmd}
#
# Pops entries from @pi_notifications until it finds a live tmux target, then
# switches to that target. New entries are pane IDs; legacy session names also
# remain valid tmux targets during migration.

set -e

while true; do
  raw="$(tmux show-option -gqv @pi_notifications)"
  [ -z "$raw" ] && exit 0

  target="${raw%%,*}"
  rest="${raw#*,}"

  if [ "$rest" = "$raw" ]; then
    tmux set-option -gu @pi_notifications
  else
    tmux set-option -g @pi_notifications "$rest"
  fi

  if tmux display-message -p -t "$target" '#{pane_id}' >/dev/null 2>&1 \
      && tmux switch-client -t "$target" 2>/dev/null; then
    exit 0
  fi
done
