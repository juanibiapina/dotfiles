#!/usr/bin/env bash
#
# Summary: Switch tmux session with a fuzzy finder
#
# Usage: {cmd}

set -e

current="$(tmux display-message -p '#S')"

selected="$(tmux list-sessions -F '#{session_name}' \
  | grep -v "^${current}$" \
  | fzf --popup center,40%,80% --reverse)" || exit 0

if [ -n "$selected" ]; then
  tmux switch-client -t "$selected"
fi
