#!/usr/bin/env bash
#
# Summary: Pin the latest GitButler nightly for the Nix package
#
# Usage: {cmd}
#
# Rewrites nix/packages/gitbutler-nightly.json when the nightly feed has a
# newer version. Each download is checked against GitButler's minisign key.
# When the feed or a download is unreachable, the pin is left as is.

set -e

source "${_DEV_ROOT}/lib/gum.sh"

FEED_URL="https://app.gitbutler.com/releases/nightly"
PUBLIC_KEY="RWTrOEI+im1XYA9RBwyxnzFN/evFzJhU1lbQ70LVayWH3WRo7xQnRLD2"
PIN_FILE="$DOTFILES_HOME/nix/packages/gitbutler-nightly.json"

declare -A FEED_PLATFORMS=(
  [aarch64-darwin]=darwin-aarch64
  [x86_64-linux]=linux-x86_64
)

if ! feed="$(curl -fsSL --max-time 30 "$FEED_URL")"; then
  warning "GitButler nightly feed unreachable; keeping the current pin"
  exit 0
fi

version="$(jq -r .version <<<"$feed")"
current="$(jq -r .version "$PIN_FILE" 2>/dev/null || true)"

if [ "$version" = "$current" ]; then
  info "GitButler nightly $version is current"
  exit 0
fi

work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT

sources='{}'
for system in "${!FEED_PLATFORMS[@]}"; do
  platform="${FEED_PLATFORMS[$system]}"
  url="$(jq -r --arg p "$platform" '.platforms[$p].url' <<<"$feed")"
  jq -r --arg p "$platform" '.platforms[$p].signature' <<<"$feed" | base64 -d >"$work_dir/$system.minisig"

  if ! prefetch="$(nix store prefetch-file --json --hash-type sha256 "$url")"; then
    warning "Could not download GitButler nightly $version for $system; keeping the current pin"
    exit 0
  fi

  store_path="$(jq -r .storePath <<<"$prefetch")"
  if ! nix shell nixpkgs#minisign --command minisign -V -q -P "$PUBLIC_KEY" -m "$store_path" -x "$work_dir/$system.minisig"; then
    error "Signature check failed for $url"
    exit 1
  fi

  sources="$(jq --arg s "$system" --arg url "$url" --arg hash "$(jq -r .hash <<<"$prefetch")" \
    '.[$s] = {url: $url, hash: $hash}' <<<"$sources")"
done

jq -S -n --arg version "$version" --argjson sources "$sources" \
  '{version: $version, sources: $sources}' >"$PIN_FILE"

success "GitButler nightly pinned to $version (was ${current:-unpinned})"
