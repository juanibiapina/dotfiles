#!/usr/bin/env bash
#
# Summary: List the issues and PRs a pi session can be snoozed on
#
# Usage: {cmd} <terminal>
# Options:
#   terminal: The pi terminal, as hc names it on this machine (t7)
#
# Run on the terminal's machine. Prints a JSON array of
# {"ref":"owner/repo#n","title":..,"source":..}, without duplicates:
#   "label"   the session's github.<owner>/<repo>#<n> labels, which the inbox sets
#   "branch"  the open PR of the branch checked out in its folder
#   "applied" in a GitButler workspace, the open PR of every applied branch
# Branches come from its folder and from each of its repos, checked out at
# $WORKSPACE/<owner>/<repo>: its repos label (repos it wrote to), else the last
# repo in its related label (repos it read), both set by pi's herdr extension.
# gh runs with each folder's direnv environment.
#
# Refuses, with the reason on stderr, a session that `dev herdr snooze` would
# refuse, or one with no candidates.

set -e

source "${_DEV_ROOT}/lib/direnv.sh"
source "${_DEV_ROOT}/lib/snooze.sh"

declare -A args="($_DEV_ARGS)"

terminal="${args[terminal]}"

current="$(snoozable "$terminal")"
cwd="$(jq -r .cwd <<<"$current")"
cd "$cwd"
load_direnv

items="$(jq -r '.labels // {} | keys[] | select(test("^github\\.[^#]+/[^#]+#[0-9]+$")) | sub("^github\\."; "")' <<<"$current" \
  | while read -r ref; do
    title="$(gh api "repos/${ref%#*}/issues/${ref##*#}" --jq .title 2>/dev/null)" || title=""
    jq -nc --arg ref "$ref" --arg title "$title" '{ref: $ref, title: $title, source: "label"}'
  done | jq -s .)"

# Adds to items the open PRs of the branches checked out in the current folder.
add_branch_prs() {
  local remote repo branch source branches prs
  remote="$(git remote get-url origin 2>/dev/null)" || return 0
  [[ "$remote" =~ github\.com[:/]([^/]+/[^/]+)$ ]] || return 0
  repo="${BASH_REMATCH[1]%.git}"
  branch="$(git branch --show-current)"
  # HEAD can sit on any branch, so `but status` succeeding marks a GitButler workspace.
  if status="$(but status --json 2>/dev/null)"; then
    source="applied"
    branches="$(jq -c '[.stacks[].branches[].name]' <<<"$status")" || branches="[]"
  else
    source="branch"
    branches="$(jq -nc --arg b "$branch" 'if $b == "" then [] else [$b] end')"
  fi
  [ "$branches" != "[]" ] || return 0
  prs="$(gh pr list -R "$repo" --state open --limit 100 --json headRefName,number,title 2>/dev/null)" || prs="[]"
  items="$(jq -c --argjson prs "$prs" --argjson branches "$branches" --arg repo "$repo" --arg source "$source" \
    '. + [$branches[] as $b | $prs[] | select(.headRefName == $b) | {ref: "\($repo)#\(.number)", title, source: $source}]' <<<"$items")"
}

add_branch_prs

while read -r declared; do
  dir="${WORKSPACE:-$HOME/workspace}/$declared"
  [ -d "$dir" ] && [ "$dir" != "$cwd" ] || continue
  cd "$dir"
  load_direnv
  add_branch_prs
done < <(jq -r '
  def list(s): (s // "") | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""));
  (.labels // {}) as $l
  | list($l.repos) as $r
  | if ($r | length) > 0 then $r[] else (list($l.related) | last // empty) end' <<<"$current")

items="$(jq -c 'reduce .[] as $i ([]; if any(.[]; .ref == $i.ref) then . else . + [$i] end)' <<<"$items")"
if [ "$items" = "[]" ]; then
  echo "$NOTHING_TO_WAIT_FOR" >&2
  exit 1
fi
printf '%s\n' "$items"
