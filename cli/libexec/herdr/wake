#!/usr/bin/env bash
#
# Summary: Bring back a pi session snoozed with dev herdr snooze
#
# Usage: {cmd} <terminal>
# Options:
#   terminal: The pi terminal, as hc names it on this machine (t7)
#
# Run on the terminal's machine. Clears the session's juan.snooze label, so
# the Herdr mods list it again. Sends pi nothing. Clearing a label that isn't
# set does nothing.

set -e

declare -A args="($_DEV_ARGS)"

hc label "${args[terminal]}" juan.snooze= >/dev/null
