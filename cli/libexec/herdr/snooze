#!/usr/bin/env bash
#
# Summary: Hide a pi session until Juan wakes it
#
# Usage: {cmd} <terminal> <ref> [refs]...
# Options:
#   terminal: The pi terminal, as hc names it on this machine (t7)
#   ref: An issue or PR the session waits on, as owner/repo#number
#   refs: More issues or PRs like ref
#
# Run on the terminal's machine. dev herdr snooze-candidates lists the refs a
# session can wait on. Labels the session github.<ref> for each ref it
# doesn't have yet, so the GitHub inbox links their notifications to it, and
# juan.snooze=<time>, which the Herdr mods hide. The inbox lists those
# notifications under Snoozed sessions; sending one to the session, or
# dev herdr wake, brings it back.
#
# Refuses, with the reason on stderr, a session that is not pi, is working,
# or is already snoozed.

set -e

source "${_DEV_ROOT}/lib/snooze.sh"

declare -A args="($_DEV_ARGS)"

terminal="${args[terminal]}"
read -r -a refs <<<"${args[ref]} ${args[refs]}"

for ref in "${refs[@]}"; do
  if ! [[ "$ref" =~ ^[^/#[:space:]]+/[^/#[:space:]]+#[0-9]+$ ]]; then
    echo "Not an owner/repo#number: $ref" >&2
    exit 1
  fi
done

current="$(snoozable "$terminal")"
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
labels=("juan.snooze=$now")
for ref in "${refs[@]}"; do
  [ "$(jq -r --arg k "github.$ref" '.labels[$k] // ""' <<<"$current")" ] || labels+=("github.$ref=$now")
done
hc label "$terminal" "${labels[@]}" >/dev/null
echo "Snoozed until you send it one of ${refs[*]}"
