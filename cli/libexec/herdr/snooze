#!/usr/bin/env bash
#
# Summary: Hide a pi session until its issue or PR has activity
#
# Usage: {cmd} [--wait-since=TIME] <terminal>
# Options:
#   terminal: The pi terminal, as hc names it on this machine (t7)
#   wait-since: Internal: run as the waiter, counting activity after TIME
#
# Run on the terminal's machine. The session waits on the threads in its
# github.<owner>/<repo>#<number> labels, which the inbox sets. With none, it
# waits on the open PR of the branch in its folder and adds that label.
#
# Starts a waiter terminal, a child of the session, and labels the session
# juan.snooze=<waiter>. The Herdr mods hide sessions with that label. When
# `dev github await-activity` reports activity, the waiter clears the label
# and sends pi a message with what happened. It also clears the label and
# exits when pi is no longer the terminal's program, or when it is killed
# (`dev herdr wake`).
#
# Refuses, with the reason on stderr, a session that is not pi, is working,
# is already snoozed, or has nothing to wait for.

set -e

declare -A args="($_DEV_ARGS)"

terminal="${args[terminal]}"
since="${args[wait-since]}"

info() { hc get "$terminal" --json; }
running_pi() { [ "$(info 2>/dev/null | jq -r '.state == "live" and .foreground.name == "pi"')" = "true" ]; }
refs_of() { jq -r '.labels // {} | keys[] | select(test("^github\\.[^#]+/[^#]+#[0-9]+$")) | sub("^github\\."; "")' <<<"$1"; }

if [ -z "$since" ]; then
  current="$(info)"
  if [ "$(jq -r .state <<<"$current")" != "live" ]; then
    echo "$terminal has ended." >&2
    exit 1
  fi
  if [ "$(jq -r '.foreground.name // ""' <<<"$current")" != "pi" ]; then
    echo "$terminal is not running pi." >&2
    exit 1
  fi
  if [ "$(jq -r '.status.state // ""' <<<"$current")" = "working" ]; then
    echo "pi is working. Snooze it once it stops." >&2
    exit 1
  fi
  if [ -n "$(jq -r '.labels["juan.snooze"] // ""' <<<"$current")" ]; then
    echo "$terminal is already snoozed." >&2
    exit 1
  fi

  cwd="$(jq -r .cwd <<<"$current")"
  since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  labels=()
  refs="$(refs_of "$current")"
  if [ -z "$refs" ]; then
    url="$(cd "$cwd" && gh pr view --json url --jq .url 2>/dev/null)" || true
    if [[ "$url" =~ ^https://github.com/([^/]+/[^/]+)/pull/([0-9]+)$ ]]; then
      refs="${BASH_REMATCH[1]}#${BASH_REMATCH[2]}"
      labels+=("github.$refs=$since")
    fi
  fi
  if [ -z "$refs" ]; then
    echo "Nothing to wait for: send it a GitHub thread from the inbox, or open a PR on its branch." >&2
    exit 1
  fi

  # The label goes on first, so the waiter finds the thread.
  [ "${#labels[@]}" -eq 0 ] || hc label "$terminal" "${labels[@]}" >/dev/null
  # juan.snooze-waiter keeps it out of the phone's lists.
  waiter="$(hc run --bg --json --rm --no-notify --parent "$terminal" --cwd "$cwd" --label "juan.snooze-waiter=$terminal" \
    -- dev herdr snooze --wait-since="$since" "$terminal" | jq -r .address)"
  hc label "$terminal" "juan.snooze=$waiter" >/dev/null
  echo "Snoozed until activity on $(tr '\n' ' ' <<<"$refs")"
  exit 0
fi

# The waiter.

me="${HC_TERMINAL_ID:-}"
out="$(mktemp)"
poll=""

# Clears the label unless another waiter owns it by now.
cleanup() {
  [ -z "$poll" ] || kill -- "-$poll" 2>/dev/null || true
  rm -f "$out"
  owner="$(info 2>/dev/null | jq -r '.labels["juan.snooze"] // ""')" || true
  if [ -n "$owner" ] && { [ -z "$me" ] || [ "$owner" = "$me" ]; }; then
    hc label "$terminal" juan.snooze= >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
trap exit HUP TERM INT

read -r -a refs <<<"$(refs_of "$(info)" | tr '\n' ' ')"
[ "${#refs[@]}" -gt 0 ] || exit 1

# Its own process group, so cleanup ends it with the sleep it runs.
set -m
dev github await-activity --since="$since" "${refs[@]}" >"$out" &
poll=$!
set +m

# Waits on the poll, and checks every 60 s that pi still runs there: a pi
# started through zsh leaves a shell behind when it quits.
ticks=0
while kill -0 "$poll" 2>/dev/null; do
  sleep 5 &
  wait $! || true
  ticks=$((ticks + 1))
  if [ $((ticks % 12)) -eq 0 ] && ! running_pi; then
    exit 0
  fi
done
wait "$poll" || exit 1
poll=""

activity="$(cat "$out")"
[ -n "$activity" ] || exit 1
running_pi || exit 0

hc label "$terminal" juan.snooze= >/dev/null
message="$(jq -r '
  "While you were snoozed, there was activity on \([.items[].url | sub("(/commits|/checks|#.*)$"; "")] | unique | join(", ")):\n"
  + ([.items[:20][] | "- \(.event | gsub("_"; " "))\(if .author then " by \(.author)" else "" end) at \(.at): \(.url)"] | join("\n"))
  + (if (.items | length) > 20 then "\n- and \(.items | length - 20) more" else "" end)
  + "\nRead what changed and carry on."' <<<"$activity")"
hc send "$terminal" "$message" >/dev/null
