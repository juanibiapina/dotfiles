#!/usr/bin/env bash
#
# Summary: Build and flash the Moonlander layout
#
# Usage: {cmd}

set -e

out="$(nix build "$DOTFILES_HOME#moonlander-firmware" --no-link --print-out-paths)"

echo "Put the Moonlander in bootloader mode: hold ; and press the top-right key on the right half, or press the reset pinhole."

nix run --inputs-from "$DOTFILES_HOME" nixpkgs#dfu-util -- \
  -w -d 0483:DF11 -a 0 -s 0x08000000:leave \
  -D "$out/zsa_moonlander_reva_juan.bin"
