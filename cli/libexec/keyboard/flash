#!/usr/bin/env bash
#
# Summary: Build and flash the Moonlander layout
#
# Usage: {cmd}

set -e

echo "==> Building the firmware"
out="$(nix build "$DOTFILES_HOME#moonlander-firmware" --no-link --print-out-paths -L --log-format raw)"

echo
echo "==> Waiting for the Moonlander in bootloader mode"
echo "    Hold the leftmost right thumb key and press the top-right key on the right half,"
echo "    or press the reset pinhole."
echo

nix run --inputs-from "$DOTFILES_HOME" nixpkgs#dfu-util -- \
  -w -d 0483:DF11 -a 0 -s 0x08000000:leave \
  -D "$out/zsa_moonlander_reva_juan.bin"

echo
echo "==> Flashed. The Moonlander restarts with the new layout."

data="$HOME/Sync/moonlander"
if [[ ! -d "$data" ]]; then
  echo "    Not recorded for key usage: $data does not exist yet." >&2
  exit 0
fi

layout="$(nix build "$DOTFILES_HOME#moonlander-keymap" --no-link --print-out-paths)/layout.json"
sha="$(shasum -a 256 "$layout" | cut -c1-12)"
mkdir -p "$data/layouts" "$data/flashes"
[[ -f "$data/layouts/$sha.json" ]] || install -m 644 "$layout" "$data/layouts/$sha.json"
printf '%s\t%s\n' "$(( $(date +%s) * 1000000 ))" "$sha" >> "$data/flashes/$(hostname -s).tsv"
echo "    Recorded layout $sha for key usage."
