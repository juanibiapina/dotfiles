#!/usr/bin/env bash
#
# Summary: Wait for activity on issues or pull requests
#
# Usage: {cmd} [--since=SINCE] [--interval=INTERVAL] <ref> [refs]...
# Options:
#   since: ISO 8601 time; only activity after it counts. Default: now
#   interval: Seconds between checks, default 60
#   ref: owner/repo#number, an issue or a pull request
#   refs: More threads like ref. Put the options before the refs
#
# Waits until someone acts on one of the threads, then prints one JSON object
# and exits:
#   {"event":"activity","checked_at":..,"items":[{"ref","url","event","author","at"}]}
#
# Activity is any issue timeline event after --since (a comment, a review, a
# label, a state or title change, an assignment, a force push...), except
# subscriptions, mentions, references and commits, and except bots other than
# Copilot. On a pull request, a new head commit counts as "pushed" and a check
# rollup that turns FAILURE or ERROR counts as "checks_failed". Juan's own
# account counts. There is no timeout.

set -e

declare -A args="($_DEV_ARGS)"

since="${args[since]:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
interval="${args[interval]:-60}"
read -r -a refs <<<"${args[ref]} ${args[refs]}"
copilot="copilot-pull-request-reviewer[bot]"

# The timeline events that count, as items.
filter='[.[]
  | select(.event as $e | ["subscribed","unsubscribed","mentioned","referenced","cross-referenced","committed"] | index($e) | not)
  | {event, at: (.submitted_at // .created_at),
     author: ((if .event == "commented" or .event == "reviewed" then (.user // .actor) else (.actor // .user) end).login // "ghost"),
     url: (.html_url // $url)}
  | select(.at != null and .at > $since)
  | select((.author | endswith("[bot]") | not) or .author == $copilot)
  | {ref: $ref, url, event, author, at}]'

rollup='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { pullRequest(number: $number) {
    headRefOid commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } } }'

declare -A updated head checks

while true; do
  checked_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  items="[]"

  for ref in "${refs[@]}"; do
    repo="${ref%#*}"
    number="${ref##*#}"
    # A failed call (network, rate limit) only skips this round.
    issue="$(gh api "repos/$repo/issues/$number" 2>/dev/null)" || continue
    url="$(jq -r .html_url <<<"$issue")"
    at="$(jq -r .updated_at <<<"$issue")"

    if [[ "$at" > "${updated[$ref]:-$since}" ]]; then
      found="$(gh api --paginate "repos/$repo/issues/$number/timeline?per_page=100" 2>/dev/null \
        | jq -s --arg since "$since" --arg copilot "$copilot" --arg ref "$ref" --arg url "$url" "add // [] | $filter")" || continue
      updated[$ref]="$at"
      items="$(jq -c --argjson more "$found" '. + $more' <<<"$items")"
    fi

    if [ "$(jq -r 'has("pull_request")' <<<"$issue")" = "true" ]; then
      pr="$(gh api graphql -f query="$rollup" -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$number" \
        --jq '.data.repository.pullRequest | [.headRefOid, (.commits.nodes[0].commit.statusCheckRollup.state // "NONE")] | @tsv' 2>/dev/null)" || continue
      read -r sha state <<<"$pr"
      if [ -n "${head[$ref]}" ] && [ "$sha" != "${head[$ref]}" ]; then
        items="$(jq -c --arg ref "$ref" --arg url "$url/commits" --arg at "$checked_at" \
          '. + [{ref: $ref, url: $url, event: "pushed", author: null, at: $at}]' <<<"$items")"
      fi
      if [ -n "${checks[$ref]}" ] && [ "$state" != "${checks[$ref]}" ] && { [ "$state" = "FAILURE" ] || [ "$state" = "ERROR" ]; }; then
        items="$(jq -c --arg ref "$ref" --arg url "$url/checks" --arg at "$checked_at" \
          '. + [{ref: $ref, url: $url, event: "checks_failed", author: null, at: $at}]' <<<"$items")"
      fi
      head[$ref]="$sha"
      checks[$ref]="$state"
    fi
  done

  if [ "$(jq length <<<"$items")" -gt 0 ]; then
    jq -nc --arg at "$checked_at" --argjson items "$items" '{event: "activity", checked_at: $at, items: $items}'
    exit 0
  fi

  sleep "$interval"
done
