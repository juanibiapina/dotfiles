#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
dev="${DEV:-$root/dotfiles/bin/bin/dev}"
temp="$(mktemp -d)"
trap 'rm -rf "$temp"' EXIT
export XDG_STATE_HOME="$temp/state"
project="$temp/project"
mkdir "$project"

run() { "$dev" "$@"; }
path_for() { run artifacts path -- "$1" "$project"; }
assert_eq() { [ "$1" = "$2" ] || { printf 'expected %q, got %q\n' "$2" "$1" >&2; exit 1; }; }
assert_missing() { [ ! -e "$1" ] || { printf 'unexpected path: %s\n' "$1" >&2; exit 1; }; }

while IFS=$'\t' read -r name expected; do
  assert_eq "$(basename "$(path_for "$name")")" "$expected"
done <<'CASES'
plan	plan.md
My Plan.md	my-plan.md
../escape	escape.md
..\..\win.txt	win.txt
a/b/c.txt	c.txt
.hidden	hidden.md
notes.tar.gz	notes.tar.gz
a.b.c	a.b.c
2026-plan.v2.md	2026-plan.v2.md
file.	file.md
x.MD	x.md
x.t@r	x.tr
plan!!!	plan.md
a  b	a-b.md
-lead-	lead.md
Ünicode	nicode.md
artifacts cli ownership plan	artifacts-cli-ownership-plan.md
CASES
assert_eq "$(basename "$(path_for $'a\nb')")" "a-b.md"
assert_eq "$(basename "$(path_for $'a\tb')")" "a-b.md"
assert_eq "$(basename "$(path_for 'x" $(id) "')")" "x-id.md"
assert_eq "$(basename "$(path_for 'x`id`y')")" "x-id-y.md"
! path_for '...' >/dev/null 2>&1
! path_for '  ' >/dev/null 2>&1
! path_for '🙂' >/dev/null 2>&1

marker="$temp/pwned"
malicious='x" $(touch '"$marker"') ` )'
path_for "$malicious" >/dev/null
printf 'content\n' > "$temp/content"
run artifacts save --content-file="$temp/content" --title="$malicious" --type="$malicious" -- "$malicious" "$project" >/dev/null
assert_missing "$marker"

saved="$(run artifacts save --content-file="$temp/content" --title=Title --type=plan -- --weird "$project")"
[ -f "$saved" ]
dir="$(run artifacts dir "$project")"
mode="$(stat -f %Lp "$dir" 2>/dev/null || true)"
[[ "$mode" =~ ^[0-9]+$ ]] || mode="$(stat -c %a "$dir")"
assert_eq "$mode" "700"
assert_eq "$(cat "$saved")" "content"

printf 'stdin content\n\n' > "$temp/stdin-expected"
cat "$temp/stdin-expected" | run artifacts save -- --stdin "$project" >/dev/null
cmp "$temp/stdin-expected" "$(path_for --stdin)"

printf 'first\n' > "$temp/first"
printf 'second\n' > "$temp/second"
run artifacts save --content-file="$temp/first" --title=one -- first "$project" >/dev/null &
pid1=$!
run artifacts save --content-file="$temp/second" --type=note -- second "$project" >/dev/null &
pid2=$!
wait "$pid1" "$pid2"
index="$dir/.index.json"
assert_eq "$(jq -r '."first.md".title' "$index")" one
assert_eq "$(jq -r '."second.md".type' "$index")" note

special=$'tab\tnewline\nback\\slash'
run artifacts save --content-file="$temp/content" --title="$special" -- special "$project" >/dev/null
json="$(run artifacts list --format=json -- "$project")"
assert_eq "$(jq -r '.[] | select(.name == "special.md") | .title' <<< "$json")" "$special"

printf 'bad json' > "$index"
run artifacts save --content-file="$temp/content" --title=recovered -- recovered "$project" >/dev/null 2>"$temp/warning"
grep -q 'corrupt' "$temp/warning"
compgen -G "$index.corrupt.*" >/dev/null
assert_eq "$(jq -r '."recovered.md".title' "$index")" recovered
: > "$index"
run artifacts save --content-file="$temp/content" --title=empty-recovered -- empty "$project" >/dev/null 2>"$temp/warning"
grep -q 'corrupt' "$temp/warning"

completions="$(cd "$project" && run --completions artifacts delete)"
grep -qx 'recovered.md' <<< "$completions"
grep -qx 'first.md' <<< "$completions"
! grep -q $'\t' <<< "$completions"
! grep -q '/' <<< "$completions"
assert_eq "$(cd "$project" && run --completions artifacts path)" "$completions"
assert_eq "$(cd "$project" && run --completions artifacts save)" "$completions"

blank="$temp/blank"
mkdir "$blank"
assert_eq "$(cd "$blank" && run --completions artifacts delete)" ""

run artifacts delete -- first "$project" >/dev/null
[ ! -e "$(path_for first)" ]
! run artifacts delete -- first "$project" >/dev/null 2>&1

# Exercise the picker through fake fzf and gum adapters. The fzf adapter invokes
# the configured ctrl-d action for the first record, as if the user pressed it.
fake_bin="$temp/fake-bin"
mkdir "$fake_bin"
cat > "$fake_bin/fzf" <<'FZF'
#!/usr/bin/env bash
set -euo pipefail
records="$(cat)"
selection="${records%%$'\n'*}"
for arg in "$@"; do
  case "$arg" in
    ctrl-d:execute\(*)
      helper="${arg#ctrl-d:execute(}"
      helper="${helper%% *}"
      "$helper" "$selection"
      exit 1
      ;;
  esac
done
printf 'ctrl-d action not found\n' >&2
exit 2
FZF
cat > "$fake_bin/gum" <<'GUM'
#!/usr/bin/env bash
[ "$1" = confirm ]
[ "${GUM_CONFIRM:-no}" = yes ]
GUM
chmod +x "$fake_bin"/*

printf 'picker content\n' > "$temp/picker"
run artifacts save --content-file="$temp/picker" --title=picker -- picker-delete "$project" >/dev/null
picker_path="$(path_for picker-delete)"
PATH="$fake_bin:$PATH" GUM_CONFIRM=no run artifacts browse "$project"
[ -f "$picker_path" ]
assert_eq "$(jq -r '."picker-delete.md".title' "$index")" picker
PATH="$fake_bin:$PATH" GUM_CONFIRM=yes run artifacts browse "$project"
[ ! -e "$picker_path" ]
assert_eq "$(jq 'has("picker-delete.md")' "$index")" false

empty="$temp/empty"
mkdir "$empty"
assert_eq "$(run artifacts list --format=json -- "$empty")" '[]'
