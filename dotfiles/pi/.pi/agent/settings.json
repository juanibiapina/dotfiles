{
  "lastChangelogVersion": "0.84.4",
  "theme": "tokyonight-moon",
  "tuiMode": "fullscreen",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-8",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "shellCommandPrefix": "export GIT_EDITOR=true",
  "packages": [
    "~/.pi/agent/pi-packages/pi-extension-settings",
    "~/.pi/agent/pi-packages/pi-powerbar",
    "~/.pi/agent/pi-packages/pi-tokyonight",
    "~/.pi/agent/pi-packages/pi-gob",
    "npm:@ff-labs/pi-fff"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "enabledModels": [
    "anthropic/claude-opus-4-8:high"
  ],
  "doubleEscapeAction": "none",
  "terminal": {
    "clearOnShrink": false
  },
  "compaction": {
    "enabled": true
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultProjectTrust": "always"
}