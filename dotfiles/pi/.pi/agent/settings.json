{
  "lastChangelogVersion": "1.0.1",
  "theme": "tokyonight-moon",
  "tuiMode": "fullscreen",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "low",
  "defaultTools": [
    "+codemode"
  ],
  "editorPaddingX": 1,
  "shellCommandPrefix": "export GIT_EDITOR=true; grep() { grg \"$@\"; }; find() { fnd \"$@\"; };",
  "packages": [
    "~/.pi/agent/pi-packages/pi-extension-settings",
    "~/.pi/agent/pi-packages/pi-powerbar",
    "~/.pi/agent/pi-packages/pi-tokyonight",
    "~/.pi/agent/pi-packages/pi-gob",
    "~/.pi/agent/pi-packages/pi-workbench"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-luna:xhigh",
    "openai-codex/gpt-6.1-sol:low",
    "openai-codex/gpt-6-astra:medium",
    "anthropic/claude-sonnet-5-5:medium",
    "anthropic/claude-opus-5-5:medium"
  ],
  "doubleEscapeAction": "none",
  "terminal": {
    "clearOnShrink": false
  },
  "compaction": {
    "enabled": true
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultProjectTrust": "always"
}