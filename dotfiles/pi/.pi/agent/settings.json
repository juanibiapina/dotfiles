{
  "lastChangelogVersion": "1.5.2",
  "theme": "light/tokyonight-moon",
  "tuiMode": "fullscreen",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode",
    "+grep",
    "+find"
  ],
  "editorPaddingX": 1,
  "shellCommandPrefix": "export GIT_EDITOR=true",
  "packages": [
    "~/.pi/agent/pi-packages/pi-extension-settings",
    "~/.pi/agent/pi-packages/pi-powerbar",
    "~/.pi/agent/pi-packages/pi-tokyonight",
    "~/.pi/agent/pi-packages/pi-gob",
    "~/.pi/agent/pi-packages/pi-workbench",
    "npm:@nicknisi/pi-artifacts"
  ],
  "skills": [
    "~/.agents/skills"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-luna:xhigh",
    "openai-codex/gpt-6.1-sol:low",
    "openai-codex/gpt-6-astra:medium",
    "anthropic/claude-sonnet-5-5:medium",
    "anthropic/claude-opus-5-5:medium"
  ],
  "doubleEscapeAction": "none",
  "terminal": {
    "clearOnShrink": false
  },
  "compaction": {
    "enabled": true
  },
  "retry": {
    "maxRetries": 100000,
    "maxAgentDelayMs": 300000
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultProjectTrust": "always",
  "extensionChangelogVersions": {
    "{\"source\":\"~/.pi/agent/pi-packages/pi-extension-settings\",\"scope\":\"user\"}": "0.10.0",
    "{\"source\":\"~/.pi/agent/pi-packages/pi-powerbar\",\"scope\":\"user\"}": "0.16.0",
    "{\"source\":\"~/.pi/agent/pi-packages/pi-gob\",\"scope\":\"user\"}": "0.7.1",
    "{\"source\":\"~/.pi/agent/pi-packages/pi-workbench\",\"scope\":\"user\"}": "0.1.2"
  }
}